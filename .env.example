VITE_LEADS_API_BASE_URL=http://localhost:3000
VITE_LEADS_API_TOKEN=your_leads_token
VITE_LEADS_CAMPAIGN_ID=your_campaign_id
# Contact form email (Resend).
# Server-side only — do NOT add a VITE_ prefix. VITE_ vars are inlined into the
# public JS bundle, which would publish the API key to every visitor.
# Set the same three in Vercel > nexdim-main > Settings > Environment Variables.
RESEND_API_KEY=

# Must be on a domain verified in Resend. Verify the send.nexdimai.com SUBDOMAIN
# rather than the root: the root SPF is "v=spf1 include:secureserver.net -all",
# a hard fail scoped to GoDaddy, so adding Resend at the root risks the existing
# mailbox. No mailbox is needed for this address — only the DNS records.
RESEND_FROM_EMAIL=Nexdim AI <noreply@send.nexdimai.com>

# Where enquiries land. replyTo is set to the sender, so Reply goes to them.
RESEND_TO_EMAIL=contact@nexdimai.com
